---
import {
  EvolutionTriggerById,
  GenderById,
  item_by_id,
  location_by_id,
  MoveById,
  TypeById,
  PokemonById,
  PokemonSpeciesById,
} from "src/utils/data-read";
import { capitalizeFirstLetter, capitalizeSnakeCase } from "src/utils/string";

const {
  evolution_trigger_id,
  trigger_item_id,
  minimum_level,
  gender_id,
  location_id,
  held_item_id,
  time_of_day,
  known_move_id,
  known_move_type_id,
  minimum_happiness,
  minimum_beauty,
  minimum_affection,
  relative_physical_stats,
  party_species_id,
  party_type_id,
  trade_species_id,
  needs_overworld_rain,
  turn_upside_down,
} = Astro.props;

// Map evolution trigger to color
const getTriggerColor = (triggerId: number): { bg: string; text: string; border: string } => {
  const triggerName = EvolutionTriggerById[triggerId]?.identifier || "";

  const colorMap: Record<string, { bg: string; text: string; border: string }> = {
    level: { bg: "bg-green-100", text: "text-green-900", border: "border-l-green-400" },
    trade: { bg: "bg-orange-100", text: "text-orange-900", border: "border-l-orange-400" },
    use_item: { bg: "bg-purple-100", text: "text-purple-900", border: "border-l-purple-400" },
    shed: { bg: "bg-blue-100", text: "text-blue-900", border: "border-l-blue-400" },
    spin: { bg: "bg-pink-100", text: "text-pink-900", border: "border-l-pink-400" },
    tower_of_darkness: { bg: "bg-indigo-100", text: "text-indigo-900", border: "border-l-indigo-400" },
    tower_of_waters: { bg: "bg-cyan-100", text: "text-cyan-900", border: "border-l-cyan-400" },
    three_critical_hits: { bg: "bg-red-100", text: "text-red-900", border: "border-l-red-400" },
    take_damage: { bg: "bg-rose-100", text: "text-rose-900", border: "border-l-rose-400" },
  };

  return colorMap[triggerName] || { bg: "bg-gray-100", text: "text-gray-900", border: "border-l-gray-400" };
};

// Build conditions array
const conditions: Array<{ label: string; value: string }> = [
  minimum_level && { label: "Min Level", value: String(minimum_level) },
  gender_id && { label: "Gender", value: capitalizeFirstLetter(GenderById[gender_id].identifier) },
  location_id && { label: "Location", value: capitalizeSnakeCase(location_by_id[location_id].identifier) },
  trigger_item_id && { label: "Trigger Item", value: capitalizeSnakeCase(item_by_id[trigger_item_id].identifier) },
  held_item_id && { label: "Held Item", value: capitalizeSnakeCase(item_by_id[held_item_id].identifier) },
  time_of_day && { label: "Time of Day", value: capitalizeFirstLetter(time_of_day) },
  known_move_id && { label: "Known Move", value: capitalizeSnakeCase(MoveById[known_move_id].identifier) },
  known_move_type_id && { label: "Known Move Type", value: capitalizeSnakeCase(TypeById[known_move_type_id].identifier) },
  minimum_happiness && { label: "Min Happiness", value: String(minimum_happiness) },
  minimum_beauty && { label: "Min Beauty", value: String(minimum_beauty) },
  minimum_affection && { label: "Min Affection", value: String(minimum_affection) },
  relative_physical_stats === null
    ? null
    : relative_physical_stats === 1
      ? { label: "Stats", value: "Attack > Defense" }
      : relative_physical_stats === 0
        ? { label: "Stats", value: "Attack = Defense" }
        : { label: "Stats", value: "Attack < Defense" },
  party_species_id && { label: "Party Species", value: capitalizeSnakeCase(PokemonSpeciesById[party_species_id].identifier) },
  party_type_id && { label: "Party Type", value: capitalizeSnakeCase(TypeById[party_type_id].identifier) },
  trade_species_id && { label: "Trade With", value: capitalizeSnakeCase(PokemonSpeciesById[trade_species_id].identifier) },
  needs_overworld_rain && { label: "Condition", value: "Needs Overworld Rain" },
  turn_upside_down && { label: "Condition", value: "Turn Console Upside Down" },
].filter(Boolean) as Array<{ label: string; value: string }>;

const triggerColor = getTriggerColor(evolution_trigger_id);
const triggerName = capitalizeSnakeCase(EvolutionTriggerById[evolution_trigger_id].identifier);
---

<div class={`${triggerColor.border} border-l-4 bg-gray-50 rounded-r-md p-3 mb-2`}>
  {/* Evolution Method Badge */}
  <div class="mb-3">
    <span class={`${triggerColor.bg} ${triggerColor.text} inline-block rounded px-3 py-1 text-sm font-semibold`}>
      {triggerName}
    </span>
  </div>

  {/* Conditions */}
  {conditions.length > 0 ? (
    <div>
      <p class="text-xs font-semibold text-gray-600 uppercase mb-2">Conditions:</p>
      <div class={`grid gap-2 ${conditions.length >= 4 ? "grid-cols-1 md:grid-cols-2" : "grid-cols-1"}`}>
        {conditions.map(({ label, value }) => (
          <div class="text-sm text-gray-800">
            <span class="font-medium">{label}:</span> <span class="text-gray-700">{value}</span>
          </div>
        ))}
      </div>
    </div>
  ) : null}
</div>
