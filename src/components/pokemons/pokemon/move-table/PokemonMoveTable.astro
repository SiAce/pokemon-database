---
import versionColorJson from "src/utils/color/version-color.json";
import { VersionByVersionGroup, VersionNameById } from "src/utils/data-read";
import MoveMethodSection from "./MoveMethodSection.astro";
import { versionAbbreviation } from "src/utils/string";

const { pokemonMoveByMethod, versionGroupIds } = Astro.props;
---

<table class="!table w-full table-auto border-collapse">
  <colgroup>
    <col span="5" />
    {versionGroupIds.map((id) => <col id={`col-${id}`} />)}
  </colgroup>
  <thead>
    <tr>
      <th colspan="5"></th>
      {
        versionGroupIds.map((id) => (
          <th>
            <button class="h-[1.5em] aspect-square m-1 cursor-pointer" type="button" id={id} aria-expanded={true}>
              -
            </button>
          </th>
        ))
      }
    </tr>
    <tr>
      <th class="font-black" colspan="5">Version Group:</th>
      {
        versionGroupIds.map((versionGroupId) => (
          <th class="p-0">
            <div class="inline-flex justify-center items-center">
              <div class="flex">
                {VersionByVersionGroup[versionGroupId].map((version) => (
                  <a
                    title={VersionNameById[version.id].name}
                    style={` background-color: ${versionColorJson[version.id]}; color: white; padding: 0 0.2em;`}
                  >
                    {versionAbbreviation(VersionNameById[version.id].name)}
                  </a>
                ))}
              </div>
            </div>
          </th>
        ))
      }
    </tr>
    <tr>
      <th>Move</th>
      <th>Type</th>
      <th>Power</th>
      <th title="Accuracy">Acc</th>
      <th>PP</th>
      <th colspan="100%">LVL</th>
    </tr>
  </thead>
  {
    Object.keys(pokemonMoveByMethod).map((pokemon_move_method_id) => (
      <MoveMethodSection
        pokemon_move_method_id={pokemon_move_method_id}
        pokemonMoveByMove={pokemonMoveByMethod[pokemon_move_method_id]}
        versionGroupIds={versionGroupIds}
      />
    ))
  }
</table>
<style>
  th {
    padding: 0 0.5em;
  }
  tr {
    border-bottom: 1px solid var(--sl-color-gray-6);
  }
</style>
<script define:vars={{ versionGroupIds, pokemonMoveByMethod }}>
  const tbodys = {};
  const original_trs = {};
  for (pokemon_move_method_id in pokemonMoveByMethod) {
    tbodys[pokemon_move_method_id] = document.getElementById(`tbody|${pokemon_move_method_id}`);
    original_trs[pokemon_move_method_id] = [];
    for (move_id in pokemonMoveByMethod[pokemon_move_method_id]) {
      original_trs[pokemon_move_method_id].push(document.getElementById(`${pokemon_move_method_id}|${move_id}`));
    }
  }

  versionGroupIds.forEach((versionGroupId) => {
    const button = document.getElementById(versionGroupId);
    const otherIds = versionGroupIds.filter((id) => id !== versionGroupId);
    const sorted_trs = {};
    for (pokemon_move_method_id in pokemonMoveByMethod) {
      const pokemonMoveByMove = pokemonMoveByMethod[pokemon_move_method_id];
      const sorted_move_ids = [];
      sorted_trs[pokemon_move_method_id] = [];
      for (move_id in pokemonMoveByMove) {
        const pokemonMoveByVersionGroup = pokemonMoveByMove[move_id];
        if (pokemonMoveByVersionGroup[versionGroupId]) {
          sorted_move_ids.push(move_id);
        }
      }
      sorted_move_ids.sort(
        (a, b) => pokemonMoveByMove[a][versionGroupId].at(-1).level - pokemonMoveByMove[b][versionGroupId].at(-1).level
      );

      sorted_move_ids.forEach((move_id) => {
        sorted_trs[pokemon_move_method_id].push(document.getElementById(`${pokemon_move_method_id}|${move_id}`));
      });
    }

    button.addEventListener("click", () => {
      if (button.ariaExpanded === "true") {
        otherIds.forEach((id) => {
          const col = document.getElementById(`col-${id}`);
          col.style.visibility = "collapse";
          const otherButton = document.getElementById(id);
          otherButton.disabled = true;
        });
        for (pokemon_move_method_id in pokemonMoveByMethod) {
          tbodys[pokemon_move_method_id].textContent = "";
          sorted_trs[pokemon_move_method_id].forEach((move_tr) => tbodys[pokemon_move_method_id].appendChild(move_tr));
        }

        button.ariaExpanded = false;
        button.innerHTML = "+";
      } else {
        versionGroupIds.forEach((id) => {
          const col = document.getElementById(`col-${id}`);
          col.style.visibility = "visible";
          const anyButton = document.getElementById(id);
          anyButton.disabled = false;
        });
        for (pokemon_move_method_id in pokemonMoveByMethod) {
          tbodys[pokemon_move_method_id].textContent = "";
          original_trs[pokemon_move_method_id].forEach((move_tr) =>
            tbodys[pokemon_move_method_id].appendChild(move_tr)
          );
        }

        button.ariaExpanded = true;
        button.innerHTML = "-";
      }
    });
  });
</script>
