---
import { Icon } from "@astrojs/starlight/components";
import PokemonCard from "../PokemonCard.astro";
import EvolutionMethod from "./EvolutionMethod.astro";
import { PokemonEvolutionBySpeciesId } from "src/utils/data-read";

const { id, evolvesTo, isRoot } = Astro.props;
---

<div class="flex items-center">
  {
    !isRoot && (
      <div class="mr-3">
        <Icon name="right-arrow" size="2em" />
        <div class="ml-2">
          {PokemonEvolutionBySpeciesId[id]?.map((evolution, idx) => (
            <div class={idx > 0 ? "mt-2 border-t border-gray-300 pt-2" : ""}>
              <EvolutionMethod {...evolution} />
            </div>
          ))}
        </div>
      </div>
    )
  }
  <PokemonCard id={id} />
  {
    evolvesTo[id] && (
      <div class="flex flex-col">
        {evolvesTo[id].map((evolvesToId) => (
          <Astro.self id={evolvesToId} evolvesTo={evolvesTo} />
        ))}
      </div>
    )
  }
</div>
