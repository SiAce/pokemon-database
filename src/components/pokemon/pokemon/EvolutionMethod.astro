---
import {
  EvolutionTriggerById,
  GenderById,
  item_by_id,
  location_by_id,
  MoveById,
  TypeById,
  PokemonById,
  PokemonSpeciesById,
} from "src/utils/data-read";
import { capitalizeFirstLetter, capitalizeSnakeCase } from "src/utils/string";

const {
  evolution_trigger_id,
  trigger_item_id,
  minimum_level,
  gender_id,
  location_id,
  held_item_id,
  time_of_day,
  known_move_id,
  known_move_type_id,
  minimum_happiness,
  minimum_beauty,
  minimum_affection,
  relative_physical_stats,
  party_species_id,
  party_type_id,
  trade_species_id,
  needs_overworld_rain,
  turn_upside_down,
} = Astro.props;

const triggerId = EvolutionTriggerById[evolution_trigger_id]?.identifier ?? "other";

const triggerLabels: Record<string, string> = {
  "level-up": "Level up",
  trade: "Trade",
  "use-item": "Use item",
  shed: "Shed",
  spin: "Spin",
  "tower-of-darkness": "Tower of Darkness",
  "tower-of-waters": "Tower of Waters",
  "three-critical-hits": "Three critical hits",
  "take-damage": "Take damage",
  "agile-style-move": "Agile-style move",
  "strong-style-move": "Strong-style move",
  "recoil-damage": "Recoil damage",
  "use-move": "Use move",
  "three-defeated-bisharp": "Defeat three Bisharp",
  "gimmighoul-coins": "999 Gimmighoul Coins",
};

const triggerClasses: Record<string, string> = {
  "level-up": "bg-emerald-50 text-emerald-800 ring-emerald-200",
  trade: "bg-amber-50 text-amber-800 ring-amber-200",
  "use-item": "bg-violet-50 text-violet-800 ring-violet-200",
  shed: "bg-sky-50 text-sky-800 ring-sky-200",
  spin: "bg-pink-50 text-pink-800 ring-pink-200",
  "tower-of-darkness": "bg-indigo-50 text-indigo-800 ring-indigo-200",
  "tower-of-waters": "bg-cyan-50 text-cyan-800 ring-cyan-200",
  "three-critical-hits": "bg-red-50 text-red-800 ring-red-200",
  "take-damage": "bg-rose-50 text-rose-800 ring-rose-200",
};

const conditions = [
  minimum_level != null && `Level ${minimum_level}`,
  gender_id && capitalizeFirstLetter(GenderById[gender_id].identifier),
  location_id && `at ${capitalizeSnakeCase(location_by_id[location_id].identifier)}`,
  trigger_item_id && `with ${capitalizeSnakeCase(item_by_id[trigger_item_id].identifier)}`,
  held_item_id && `holding ${capitalizeSnakeCase(item_by_id[held_item_id].identifier)}`,
  time_of_day && `at ${capitalizeFirstLetter(time_of_day)}`,
  known_move_id && `knows ${capitalizeSnakeCase(MoveById[known_move_id].identifier)}`,
  known_move_type_id && `knows a ${capitalizeSnakeCase(TypeById[known_move_type_id].identifier)} move`,
  minimum_happiness && `Happiness ${minimum_happiness}`,
  minimum_beauty && `Beauty ${minimum_beauty}`,
  minimum_affection && `Affection ${minimum_affection}`,
  relative_physical_stats === 1 && "Attack > Defense",
  relative_physical_stats === 0 && "Attack = Defense",
  relative_physical_stats != null && relative_physical_stats < 0 && "Attack < Defense",
  party_species_id && `with ${capitalizeSnakeCase(PokemonSpeciesById[party_species_id].identifier)} in party`,
  party_type_id && `with a ${capitalizeSnakeCase(TypeById[party_type_id].identifier)} Pokémon in party`,
  trade_species_id && `trade for ${capitalizeSnakeCase(PokemonSpeciesById[trade_species_id].identifier)}`,
  needs_overworld_rain && "in overworld rain",
  turn_upside_down && "with console upside down",
].filter(Boolean) as string[];

const triggerName = triggerLabels[triggerId] ?? capitalizeSnakeCase(triggerId);
const triggerClass =
  triggerClasses[triggerId] ?? "bg-slate-50 text-slate-700 ring-slate-200";
---

<div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs leading-5">
  <span class:list={["rounded-full px-2 py-0.5 font-medium ring-1", triggerClass]}>
    {triggerName}
  </span>
  {
    conditions.map((condition) => (
      <span class="text-slate-600">{condition}</span>
    ))
  }
</div>
