---
import PokemonCard from "../PokemonCard.astro";

const { idList } = Astro.props;
---

<div data-pagefind-ignore="all" class="pokemon-grid not-content">
  {
    idList?.map(({ id }) => {
      return <PokemonCard id={id} />;
    })
  }
</div>
<style>
  .pokemon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(max(144px, 100% / 9), 1fr));
  }
</style>
