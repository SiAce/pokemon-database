---
import { Icon } from "@astrojs/starlight/components";
import PokemonCard from "../PokemonCard.astro";
import EvolutionMethod from "./EvolutionMethod.astro";
import { PokemonEvolutionBySpeciesId } from "src/utils/data-read";

const { id, evolvesTo, isRoot } = Astro.props;
---

<div class="flex items-center gap-4">
  <PokemonCard id={id} />
  {
    evolvesTo[id] && (
      <div class="flex flex-col gap-8">
        {evolvesTo[id].map((evolvesToId) => (
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0">
              <Icon name="right-arrow" size="1.5em" />
            </div>
            <div class="flex items-center gap-3">
              <div class="flex flex-col gap-2 min-w-max">
                {PokemonEvolutionBySpeciesId[evolvesToId]?.map((evolution, idx) => (
                  <div class={idx > 0 ? "border-t border-gray-300 pt-2" : ""}>
                    <EvolutionMethod {...evolution} />
                  </div>
                ))}
              </div>
              <Astro.self id={evolvesToId} evolvesTo={evolvesTo} />
            </div>
          </div>
        ))}
      </div>
    )
  }
</div>
