---
import { Icon } from "@astrojs/starlight/components";
import PokemonCard from "../PokemonCard.astro";
import EvolutionMethod from "./EvolutionMethod.astro";
import { PokemonEvolutionBySpeciesId } from "src/utils/data-read";

const { id, evolvesTo } = Astro.props;
---

<div class="flex items-center gap-4">
  <PokemonCard id={id} />
  {
    evolvesTo[id] && (
      <div class="flex flex-col gap-8">
        {evolvesTo[id].map((evolvesToId) => (
          <div class="flex items-center gap-3">
            <div class="shrink-0">
              <Icon name="right-arrow" size="1.5em" />
            </div>
            <div class="flex items-center gap-3">
              <div class="mb-2 flex max-w-md flex-col gap-1">
                {PokemonEvolutionBySpeciesId[evolvesToId]?.map((evolution) => (
                  <EvolutionMethod {...evolution} />
                ))}
              </div>
              <Astro.self id={evolvesToId} evolvesTo={evolvesTo} />
            </div>
          </div>
        ))}
      </div>
    )
  }
</div>
