---
import { Icon } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Heading from "src/components/Heading.astro";
import PokemonGrid from "src/components/pokemon/pokemon/PokemonGrid.astro";
import versionColorJson from "src/utils/color/version-color.json";
import {
Generation,
GenerationNameById,
PokemonSpeciesByGenerationId,
VersionByVersionGroup,
VersionGroupByGenerationId,
VersionNameById,
} from "src/utils/data-read";

export function getStaticPaths() {
  return Generation.map(({ id }) => ({
    params: { id: String(id) },
  }));
}

const { id: stringId } = Astro.params;
const id = Number(stringId);
const generationName = GenerationNameById[id];
const headings = [
  { depth: 2, slug: "generation-number", text: `${generationName} Pokemon` },
];
---

<StarlightPage
  frontmatter={{ title: `${generationName} Pokemon` }}
  headings={headings}
>
  <div data-pagefind-ignore="all" class="flex">
    {
      id > 1 && (
        <a href={`/pokemon/by-generation/${id - 1}`} rel="prev">
          <Icon name="left-arrow" size="1.5rem" />
          <span>{`${GenerationNameById[id - 1]} Pokemon`}</span>
        </a>
      )
    }
    {
      id < Generation.length && (
        <a
          href={`/pokemon/by-generation/${id + 1}`}
          rel="next"
          class="ml-auto flex flex-col items-end"
        >
          <Icon name="right-arrow" size="1.5rem" />
          <span>{`${GenerationNameById[id + 1]} Pokemon`}</span>
        </a>
      )
    }
  </div>
  <Heading heading={headings[0]} />
  <dd>
    <a>{generationName}</a> includes
    <ul>
      {
        VersionGroupByGenerationId[id].map((versionGroup) =>
          VersionByVersionGroup[versionGroup.id].map((version) => (
            <li>
              <a style={{ color: versionColorJson[version.id] }}>
                {VersionNameById[version.id].name}
              </a>
            </li>
          )),
        )
      }
    </ul>
  </dd>
  <PokemonGrid idList={PokemonSpeciesByGenerationId[id]} />
</StarlightPage>