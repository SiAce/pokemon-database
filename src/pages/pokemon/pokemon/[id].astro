---
import { Icon } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Heading from "src/components/Heading.astro";
import PokemonEncounterTable from "src/components/pokemon/pokemon/encounter-table/PokemonEncounterTable.astro";
import EvolutionChain from "src/components/pokemon/pokemon/EvolutionChain.astro";
import PokemonMoveTable from "src/components/pokemon/pokemon/move-table/PokemonMoveTable.astro";
import TypeBadge from "src/components/pokemon/pokemon/TypeBadge.astro";
import statColorJson from "src/utils/color/stat-color.json";
import {
  AbilityById,
  encounter_version_ids_by_pokemon_id,
  encounters_grouped,
  Pokemon,
  PokemonAbilityByPokemonId,
  PokemonById,
  PokemonMoveGrouped,
  PokemonSpeciesById,
  PokemonStatByPokemonId,
  PokemonTypeByPokemonId,
  StatById,
  VersionGroupIdByPokemon,
} from "src/utils/data-read";
import { capitalizeSnakeCase } from "src/utils/string";

export function getStaticPaths() {
  return Pokemon.map((pokemon) => ({
    params: { id: String(pokemon.id) },
  }));
}

const { id } = Astro.params;
const pokemon = PokemonById[id];
const { identifier, species_id, height, weight, base_experience, is_default } =
  pokemon;
const [name] = [identifier].map(capitalizeSnakeCase);
const pokemonMoveByMethod = PokemonMoveGrouped[id];
const encounters_by_location_area_id = encounters_grouped[id];

const evolutionChainId = PokemonSpeciesById[species_id].evolution_chain_id;

const headings = [
  { depth: 2, slug: "basic-info", text: "Basic Info" },
  { depth: 2, slug: "evolution-chain", text: "Evolution Chain" },
  { depth: 2, slug: "moves", text: "Moves" },
  { depth: 2, slug: "encounters", text: "Encounters" },
];
---

<StarlightPage frontmatter={{ title: name }} headings={headings}>
  <div data-pagefind-ignore="all">
    <div class="flex">
      {
        pokemon.prev && (
          <a href={`/pokemon/pokemon/${pokemon.prev}`}>
            <Icon name="left-arrow" />
            <span>Previous #{pokemon.prev}</span>
          </a>
        )
      }
      {
        pokemon.next && (
          <a
            href={`/pokemon/pokemon/${pokemon.next}`}
            class="ml-auto flex flex-col items-end"
          >
            <Icon name="right-arrow" />
            <span>Next #{pokemon.next}</span>
          </a>
        )
      }
    </div>
    <Heading heading={headings[0]} />
    <div class="border border-gray-300 rounded-lg p-6 mb-6">
      <h3 class="text-xl font-bold mb-4 pb-4 border-b border-gray-200">{`#${id} ${name}`}</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Image and Quick Stats */}
        <div class="md:col-span-1">
          <img
            class="mx-auto w-full max-w-xs"
            src={`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`}
            width={300}
            height={300}
            alt={name}
          />
        </div>

        {/* Main Info */}
        <div class="md:col-span-2 space-y-4">
          {/* Type */}
          <div>
            <h4 class="text-sm font-semibold text-gray-600 mb-2 uppercase">Type</h4>
            {
              PokemonTypeByPokemonId[id].map((pokemonType) => (
                <TypeBadge
                  type_id={pokemonType.type_id}
                  class="text-lg px-3 py-1 mr-2 mb-2 inline-block"
                />
              ))
            }
          </div>

          {/* Abilities */}
          <div class="not-content">
            <h4 class="text-sm font-semibold text-gray-600 mb-2 uppercase">Abilities</h4>
            {
              PokemonAbilityByPokemonId[id]?.map((pokemonAbility) => (
                <span class="inline-block rounded-full px-3 py-1 mr-2 mb-2 bg-blue-100 text-blue-900 text-sm font-medium">
                  {capitalizeSnakeCase(
                    AbilityById[pokemonAbility.ability_id].identifier,
                  )}
                </span>
              ))
            }
          </div>

          {/* Physical Properties */}
          <div class="grid grid-cols-3 gap-3 not-content">
            <div class="bg-gray-100 rounded-lg p-4 text-center">
              <p class="text-xs font-semibold text-gray-600 uppercase mb-1">Height</p>
              <div class="text-lg font-bold text-gray-900">{height! / 10}m</div>
            </div>
            <div class="bg-gray-100 rounded-lg p-4 text-center">
              <p class="text-xs font-semibold text-gray-600 uppercase mb-1">Weight</p>
              <div class="text-lg font-bold text-gray-900">{weight! / 10}kg</div>
            </div>
            <div class="bg-gray-100 rounded-lg p-4 text-center">
              <p class="text-xs font-semibold text-gray-600 uppercase mb-1">XP</p>
              <div class="text-lg font-bold text-gray-900">{base_experience}</div>
            </div>
          </div>
        </div>
      </div>

      {/* Stats Section */}
      <div class="mt-6 pt-6 border-t border-gray-200">
        <h4 class="text-lg font-bold text-gray-900 mb-3 uppercase">Base Stats</h4>
        <div class="space-y-3">
          {
            PokemonStatByPokemonId[id].map((pokemonStat) => {
              const statName = StatById[pokemonStat.stat_id].identifier;
              const maxStat = 200;
              const percentage = (pokemonStat.base_stat / maxStat) * 100;
              return (
                <div class="flex items-center gap-3">
                  <span class="text-sm font-medium text-gray-700 w-24 whitespace-nowrap">{capitalizeSnakeCase(statName)}</span>
                  <div class="flex-1 bg-gray-200 rounded-full h-2 overflow-hidden">
                    <div class="h-full rounded-full transition-all" style={{ width: `${Math.min(percentage, 100)}%`, backgroundColor: statColorJson[statName] }} />
                  </div>
                  <span class="text-sm font-bold w-12 text-right" style={{ color: statColorJson[statName] }}>{pokemonStat.base_stat}</span>
                </div>
              );
            })
          }
        </div>
      </div>

      {/* EV Yield Section */}
      <div class="mt-6 pt-6 border-t border-gray-200 not-content">
        <h4 class="text-lg font-bold text-gray-900 mb-3 uppercase">Effort Value Yield</h4>
        <div class="flex flex-wrap gap-2">
          {
            PokemonStatByPokemonId[id].map((pokemonStat) => {
              const statName = StatById[pokemonStat.stat_id].identifier;
              return pokemonStat.effort > 0 && (
                <div class="px-3 py-2 rounded-lg text-sm font-semibold text-white" style={{ backgroundColor: statColorJson[statName] }}>
                  +{pokemonStat.effort} {capitalizeSnakeCase(statName)}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
    <Heading heading={headings[1]} />
    <div class="not-content overflow-x-auto">
      <EvolutionChain evolutionChainId={evolutionChainId} />
    </div>
    <Heading heading={headings[2]} />

    <div
      class="overflow-x-auto not-content text-sm whitespace-nowrap text-center"
    >
      {
        pokemonMoveByMethod && (
          <PokemonMoveTable
            pokemonMoveByMethod={pokemonMoveByMethod}
            versionGroupIds={[...VersionGroupIdByPokemon[id]].sort(
              (a, b) => a - b,
            )}
          />
        )
      }
    </div>
    <Heading heading={headings[3]} />

    <div
      class="overflow-x-auto not-content text-sm whitespace-nowrap text-center"
    >
      {
        encounters_by_location_area_id && (
          <PokemonEncounterTable
            encounters_by_location_area_id={encounters_by_location_area_id}
            encounter_version_ids={[
              ...encounter_version_ids_by_pokemon_id[id],
            ].sort((a, b) => a - b)}
          />
        )
      }
    </div>
  </div>
</StarlightPage>
